    "                x1+=.5\n",
    "                x2+=.5\n",
    "            plt.plot([x1, x1, x2, x2], [y, y+h, y+h, y], lw=2, c='k')\n",
    "            if pvalue <= 0.005:\n",
    "                plt.text((x1+x2)*.5, y+h/2, '***', ha='center', va='bottom', color='k', size=15)\n",
    "            elif pvalue <= 0.01:\n",
    "                plt.text((x1+x2)*.5, y+h/2, '**', ha='center', va='bottom', color='k', size=15)\n",
    "            else:\n",
    "                plt.text((x1+x2)*.5, y+h/2, '*', ha='center', va='bottom', color='k', size=15)\n",
