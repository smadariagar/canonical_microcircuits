    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "plt.close('all')\n",
    "\n",
    "# Parámetros que puedes modificar\n",
    "tasa_muestreo = 1000  # Hz - ¡MODIFÍCAME PARA PROBAR DIFERENTES TASAS!\n",
    "duracion = 1.0  # segundos\n",
    "tasa_promedio = 40  # spikes por segundo - ¡TAMBIÉN PUEDES MODIFICARME!\n",
    "\n",
    "# Generar eje de tiempo\n",
    "tiempo = np.linspace(0, duracion, int(duracion * tasa_muestreo))\n",
    "\n",
    "# Generar spikes aleatorios (distribución de Poisson)\n",
    "# Probabilidad de spike en cada intervalo de tiempo\n",
    "prob_spike = tasa_promedio / tasa_muestreo\n",
    "\n",
    "# Generar spikes binarios (0 = no spike, 1 = spike)\n",
    "spikes = np.random.rand(len(tiempo)) < prob_spike\n",
    "\n",
    "# Encontrar posiciones donde hay spikes\n",
    "posiciones_spikes = tiempo[spikes]\n",
    "\n",
    "# Crear el gráfico\n",
    "plt.figure(figsize=(3.3, 2))\n",
    "\n",
    "# Línea horizontal central\n",
    "plt.axhline(y=0, color='black', linewidth=1.5)\n",
    "\n",
    "# Dibujar spikes como líneas verticales\n",
    "for t_spike in posiciones_spikes:\n",
    "    plt.plot([t_spike, t_spike], [0.01, 0.6], color='k', linewidth=2)\n",
    "\n",
    "# Configuración del gráfico\n",
    "plt.xlim(0, duracion)\n",
    "plt.ylim(-0.5, 1)\n",
    "plt.xlabel('Tiempo (s)')\n",
    "plt.title(f'Spike Response')\n",
    "plt.yticks([])  # Ocultar ticks del eje Y\n",
    "plt.xticks([])\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
