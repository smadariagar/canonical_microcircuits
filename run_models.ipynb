    "\n",
    "data = [np.ones([10])*100]\n",
    "\n",
    "for group in ['2/3v2']:\n",
    "    for fold in ['v2','v22']:\n",
    "        \n",
    "        for ts in ['100', '200', '300']:\n",
    "\n",
    "            path = os.path.join(os.getcwd(), '/home/samuelmr/Documentos/Doctorado/Thesis/Defensa publica/data/ecrf_'+fold+'_old/'+ts)\n",
    "            print(path)\n",
    "            psth.PSTH_folders_data(path, l_bin) \n",
    "            psth_data = pd.read_csv(os.path.join(path, 'psth_'+str(l_bin)+'.csv'), header=None, names=names)\n",
    "            subset = psth_data[(psth_data['type'] == 'exc') & (psth_data['layer'].isin([group]))][names[3:]].values \n",
    "            pre1, crf1, ecrf1 = [], [], []\n",
    "                    \n",
    "            for i in range(10):\n",
    "                pre1 = subset[i][0*l_3:1*l_3]\n",
    "                crf1 = subset[i][1*l_3:2*l_3]\n",
    "                m = 100/(crf1-pre1)\n",
    "                n = -m*pre1\n",
    "                ecrf1 = np.concatenate((ecrf1,m*subset[i][2*l_3:3*l_3]+n), axis = 0)\n",
    "            data.append(ecrf1)\n",
    "\n",
    "    # if group == '2/3a':\n",
    "    #     data.append(np.ones([10])*100)\n",
    "\n",
    "data = np.array(data)\n",
    "\n",
    "###################### figure\n",
