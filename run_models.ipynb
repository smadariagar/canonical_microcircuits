    "\n",
    "# Definimos las etiquetas para filas y columnas (ejemplo basado en tus contrastes)\n",
    "contrast_levels = ['0 Hz', '10 Hz', '20 Hz', '30 Hz']\n",
    "\n",
    "# Iteramos sobre cada fila (i) y columna (j)\n",
    "for i in range(4):\n",
    "    for j in range(4):\n",
    "        ax = axes[i, j]  # Seleccionamos el subplot actual\n",
    "        \n",
