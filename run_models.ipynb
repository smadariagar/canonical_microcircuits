    "        psth.PSTH_folders_data(path, l_bin) \n",
    "        psth_data = pd.read_csv(os.path.join(path, 'psth_'+str(l_bin)+'.csv'), header=None, names=names)\n",
    "        subset = psth_data[(psth_data['type'] == neu) & (psth_data['layer'].isin([group]))][names[3:]].values\n",
