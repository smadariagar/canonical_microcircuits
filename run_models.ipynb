    "        # Si es el primer gráfico (arriba a la izquierda), lo apagamos o dejamos vacío\n",
    "        valor_barra_1 = np.random.rand() * 10 + 5  # Ejemplo: Respuesta V1\n",
    "        valor_barra_2 = np.random.rand() * 10 + 2  # Ejemplo: Respuesta V2\n",
